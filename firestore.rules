rules_version = '2';

// Reglas de Firestore para visitas-familia.
//
// Modelo (ver documento de requisitos, sección 3.4):
//   - usuarios/{uid}   { nombre, onesignal_player_ids[], fecha_creacion }
//   - turnos/{tid}     { usuario_ids[], fecha_inicio, fecha_fin, notas, ... }
//   - notas/{nid}      { usuario_id, texto, es_alerta, fecha_creacion }
//
// Decisión de seguridad (gap #3 del documento): sin auth. El control de acceso
// se apoya en que la URL de la PWA no se comparta fuera del núcleo familiar.
// Estas reglas cierran el único vector público: nadie puede escribir sin
// conocer el proyecto (Firebase ya impone esto), y limitamos los campos
// escribibles para evitar que un documento mal formado rompa el cliente.

service cloud.firestore {
  match /databases/{database}/documents {

    function esString(s, min, max) {
      return s is string && s.size() >= min && s.size() <= max;
    }
    function esBool(b) {
      return b is bool;
    }
    function esListaDeStrings(l, max) {
      // Validación sin comprensiones: el motor de reglas (versión compatible con
      // la implementación actual) no soporta [for (... if ...) ...]. Recorremos
      // con un bucle clásico. Acepta lista vacía (es el estado inicial de
      // onesignal_player_ids al crear un usuario nuevo).
      return l is list
        && l.size() <= max
        && (l.size() < 1 || (l[0] is string && l[0].size() > 0 && l[0].size() < 200))
        && (l.size() < 2 || (l[1] is string && l[1].size() > 0 && l[1].size() < 200))
        && (l.size() < 3 || (l[2] is string && l[2].size() > 0 && l[2].size() < 200))
        && (l.size() < 4 || (l[3] is string && l[3].size() > 0 && l[3].size() < 200))
        && (l.size() < 5 || (l[4] is string && l[4].size() > 0 && l[4].size() < 200))
        && (l.size() < 6 || (l[5] is string && l[5].size() > 0 && l[5].size() < 200))
        && (l.size() < 7 || (l[6] is string && l[6].size() > 0 && l[6].size() < 200))
        && (l.size() < 8 || (l[7] is string && l[7].size() > 0 && l[7].size() < 200))
        && (l.size() < 9 || (l[8] is string && l[8].size() > 0 && l[8].size() < 200))
        && (l.size() < 10 || (l[9] is string && l[9].size() > 0 && l[9].size() < 200));
    }

    match /usuarios/{uid} {
      allow read: if true; // la app lista nombres al entrar
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'onesignal_player_ids', 'fecha_creacion'])
        && esString(request.resource.data.nombre, 1, 200)
        && esListaDeStrings(request.resource.data.onesignal_player_ids, 10);
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['onesignal_player_ids'])
        && esListaDeStrings(request.resource.data.onesignal_player_ids, 10);
      allow delete: if false; // nadie borra usuarios desde el cliente
    }

    match /turnos/{tid} {
      allow read: if true;
      allow create: if request.resource.data.keys()
          .hasOnly(['usuario_ids', 'fecha_inicio', 'fecha_fin', 'notas', 'creado_por', 'fecha_creacion'])
        && esListaDeStrings(request.resource.data.usuario_ids, 20)
        && esString(request.resource.data.fecha_inicio, 1, 200)
        && esString(request.resource.data.fecha_fin, 1, 200)
        && esString(request.resource.data.creado_por, 1, 200);
      allow update, delete: if true;
    }

    match /notas/{nid} {
      allow read: if true;
      allow create: if request.resource.data.keys()
          .hasOnly(['usuario_id', 'texto', 'es_alerta', 'fecha_creacion'])
        && esString(request.resource.data.usuario_id, 1, 200)
        && esString(request.resource.data.texto, 1, 2000)
        && esBool(request.resource.data.es_alerta);
      allow update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
