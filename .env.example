# Plantilla de variables de entorno. Copia este archivo a `.env` y rellena los valores
# con los de tu proyecto Firebase (consola: https://console.firebase.google.com/).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OneSignal (opcional; sin esto no hay notificaciones push). App ID público de la app Web Push.
# La REST API key NO va aquí: es un secret de Cloud Functions (ver docs/ONESIGNAL.md).
VITE_ONESIGNAL_APP_ID=
